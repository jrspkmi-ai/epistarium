{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "epistarium.pathfinder.sources.v1"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "provider",
          "title",
          "url",
          "doi",
          "source_type",
          "access_status",
          "execution_status",
          "evidence_level",
          "rights",
          "license",
          "attempted_at",
          "retrieved_at",
          "response_code",
          "failure_reason",
          "query",
          "sha256",
          "synthetic",
          "notes",
          "source_aliases",
          "access_attempts"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "execution_status": {
            "enum": [
              "BLOCKED",
              "FAILED",
              "NOT_RUN",
              "PARTIAL",
              "SUCCESS"
            ]
          },
          "evidence_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "rights": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "response_code": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "query": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "synthetic": {
            "type": "boolean"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "access_attempts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "duplicate_source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    }
  }
}
